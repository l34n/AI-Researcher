[Unit]
Description=AI Researcher hourly fetch (no chat-model work)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/AI-Researcher
ExecStart=%h/AI-Researcher/.venv/bin/ai-researcher run
# Fetch, heuristics, embeddings, clustering and the templated brief only.
# Chat-model stages run in ai-researcher-analyze.service on a slower cadence.
Environment=AIR_ENRICH_BUDGET=0
Environment=AIR_JUDGE_BUDGET=0
Environment=AIR_RESEARCH_BUDGET=0
Environment=AIR_BRIEF_LLM=0

# Reddit pacing makes a fetch take a few minutes; generous ceiling.
TimeoutStartSec=2700

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/AI-Researcher/data
