# Copy to .env and edit. Every value here has a working default except the
# optional API keys, which simply disable their connector when unset.

# ---- server ----
AIR_HOST=0.0.0.0
AIR_PORT=8899
AIR_DATA_DIR=./data
# Set a token to require ?k=<token> (or an X-AIR-Token header) for access.
# Leave empty for an open LAN dashboard.
AIR_ACCESS_TOKEN=

# Minutes between in-process refreshes when running `serve` on its own.
# Leave at 0 when using the systemd timer, so ingest is not scheduled twice.
# Docker Compose defaults this to 60 so one container both serves and ingests.
AIR_AUTO_REFRESH_MIN=0

# ---- ollama enrichment ----
OLLAMA_HOST=http://localhost:11434
# Conservative default. Leave OLLAMA_CHAT_MODEL empty to auto-pick, which
# prefers this tag and refuses anything above 8B just because it is installed.
OLLAMA_DEFAULT_CHAT_MODEL=gemma3:4b
# Leave empty to auto-detect the best installed chat model (capped as above).
OLLAMA_CHAT_MODEL=
# Optional per-role overrides. Unset = the workhorse (or premium for research/brief).
AIR_ENRICH_MODEL=
AIR_JUDGE_MODEL=
AIR_RESEARCH_MODEL=
AIR_BRIEF_MODEL=
# Leave empty to auto-detect an embedding model; falls back to hashed TF-IDF
# (near-duplicate wording only — not "same story, different words").
OLLAMA_EMBED_MODEL=
# Seconds to allow one generation before giving up.
OLLAMA_TIMEOUT=180
#
# Resource budgets. Hitting a limit degrades that stage to rules/templates.
AIR_MAX_MODEL_MEMORY_GB=8
AIR_MAX_CONTEXT=8192
AIR_MAX_CONCURRENT_GEN=2
AIR_DAILY_MODEL_CALLS=250        # cloud (Gemini/OpenRouter) calls per day; local Ollama calls are not counted
AIR_PREFER_DEVICE=auto
#
# Enrichment is two-pass: rules classify EVERY item (instant), then the model
# rewrites only the top-priority ones. These two bound that second pass.
# Raise them if your GPU is fast; lower them if runs take too long.
AIR_ENRICH_BUDGET=40          # max items the model rewrites per run
AIR_ENRICH_TIME_BUDGET=900    # hard wall-clock stop for the model pass, seconds
#
# Judgment scores every item on quality / practicality / feasibility /
# usefulness. The model pass only refines the highest-readiness ones.
AIR_JUDGE_BUDGET=24
AIR_JUDGE_TIME_BUDGET=400
#
# Karpathy deep research: multi-turn wiki (ingest → claims → critique →
# adapt → lint) for stories that clear the readiness gate. Small on
# purpose — five model calls per story.
AIR_RESEARCH_BUDGET=4
AIR_RESEARCH_TIME_BUDGET=900
AIR_RESEARCH_THRESHOLD=0.62   # readiness required to spend a research slot
#
# Optional cloud chat. Unset = local Ollama only; nothing is sent off-box.
# When a key is set:
#   workhorse (enrich + low-readiness judge) = Gemini Flash, else cheap
#   OpenRouter, else Ollama
#   premium (research wiki, daily brief, high-readiness judge) = OpenRouter
#   high-end model, else Gemini Pro, else the workhorse
# AIR_PREMIUM_READINESS is the heuristic-readiness floor for the premium
# judge pass. Default matches the research gate.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PREMIUM_MODEL=gemini-2.5-pro
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_PREMIUM_MODEL=anthropic/claude-sonnet-4
AIR_PREMIUM_READINESS=0.62

# ---- ingest tuning ----
AIR_USER_AGENT=ai-researcher/0.1 (+local dashboard)
AIR_FETCH_CONCURRENCY=8
AIR_ITEM_MAX_AGE_DAYS=14
AIR_RETENTION_DAYS=120

# ---- optional connectors ----
# X / Twitter API v2. Requires a paid tier; connector stays off without it.
X_BEARER_TOKEN=
#
# Reddit: LEAVE THESE EMPTY. Reddit ended self-serve API key creation with its
# Responsible Builder Policy, so new script apps can no longer be registered.
# The connector runs against the public endpoints, paced to stay under the
# unauthenticated limit, and falls back to per-subreddit RSS when throttled.
# Only fill these in if you hold approved credentials already.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
#
# GitHub raises the API rate limit from 60/hr to 5000/hr. A classic token with
# NO scopes checked is enough — this only reads public repos. Strongly
# recommended: the release+trending connectors make ~30 calls per run.
GITHUB_TOKEN=
